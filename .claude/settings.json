      "Bash(moon tasks *)",
      "Bash(moon project-graph *)",
      "Bash(moon task-graph *)",
      "Bash(moon action-graph *)",
      "Bash(moon exec *)",
      "Bash(moon bin *)",
      "Bash(moon clean *)",
      "Bash(moon --version)",
      "Bash(proto install *)",
      "Bash(proto use *)",
      "Bash(proto status *)",
      "Bash(proto list *)",
      "Bash(proto ls *)",
      "Bash(proto versions *)",
      "Bash(proto outdated *)",
      "Bash(proto bin *)",
      "Bash(proto run *)",
      "Bash(proto diagnose *)",
      "Bash(proto --version)",
      "Bash(bun install *)",
      "Bash(bun add *)",
      "Bash(bun remove *)",
      "Bash(bun update *)",
      "Bash(bun outdated *)",
      "Bash(bun pm *)",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(bun build *)",
      "Bash(bun --version)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo nextest *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo run *)",
      "Bash(cargo bench *)",
      "Bash(cargo doc *)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo update *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo --version)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git describe *)",
      "Bash(git shortlog *)",
      "Bash(git reflog *)",
      "Bash(git remote -v)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo view *)",
      "Bash(gh label list *)",
      "Bash(gh search *)",
      "Bash(gh auth status *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "mcp__moon__get_projects",
      "mcp__moon__get_project",
      "mcp__moon__get_tasks",
      "mcp__moon__get_task",
      "mcp__moon__get_changed_files",
      "mcp__moon__get_templates",
      "mcp__moon__get_template"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(drizzle-kit push *)",
      "Bash(bunx drizzle-kit push *)",
      "Bash(bun x drizzle-kit push *)",
      "Bash(npx drizzle-kit push *)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(bat *.env*)",
      "Bash(source *.env*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(.envrc)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
